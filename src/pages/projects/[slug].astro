---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { site } from '../../data/site';
import { getProjectImage } from '../../data/projectImages';
export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}
type Props = { project: CollectionEntry<'projects'> };
const { project } = Astro.props as Props;
const data = project.data;
const allProjects = (await getCollection('projects')).sort((a,b)=>a.data.order-b.data.order);
const projectIndex = allProjects.findIndex((item)=>item.slug===project.slug);
const previous = allProjects[(projectIndex - 1 + allProjects.length) % allProjects.length];
const next = allProjects[(projectIndex + 1) % allProjects.length];
const categoryNames = { academic:'Académico', personal:'Personal', professional:'Profesional / colaborativo' };
const category = data.category ? categoryNames[data.category] : undefined;
const cover = getProjectImage(data.cover);
const gallery = (data.gallery ?? []).map(getProjectImage).filter((image): image is import('astro').ImageMetadata => Boolean(image));
const fieldRows: [string, string | undefined][] = [
  ['Objetivo', data.objective], ['Problema que resuelve', data.problem], ['Solución desarrollada', data.solution ?? data.description],
].filter(([, value]) => Boolean(value));
const infoRows: [string, string | undefined][] = [
  ['Estado', data.status], ['Rol', data.myRole], ['Año', data.year], ['Equipo', data.team],
].filter(([, value]) => Boolean(value));
---
<BaseLayout title={`${data.name} — ${site.shortName}`} description={data.shortDescription}>
  <section id="project-detail" data-n="Proyecto" style="padding-top:7rem"><div class="wrap" id="dv">
    <a class="back mono" href="/projects">← Volver a proyectos</a>{category && <span class="mono" style="color:var(--cu);display:block">{category}</span>}
    <h1 class="dt">{data.name}</h1><p class="dd">{data.shortDescription}</p>
    {cover && <Image class="dh" src={cover} alt={`Captura de ${data.name}`} widths={[720,1080,1440]} sizes="100vw" fetchpriority="high" />}
    {infoRows.length > 0 && <div class="info">{infoRows.map(([label, value]) => <div class="mono">{label}<b>{value}</b></div>)}</div>}
    {fieldRows.map(([label, value], index) => <div class="ds"><h3>{String(index+2).padStart(2,'0')} · {label}</h3><div><p>{value}</p></div></div>)}
    {data.features && data.features.length > 0 && <div class="ds"><h3>Funcionalidades</h3><div><ul class="f">{data.features.map((feature)=><li>{feature}</li>)}</ul></div></div>}
    {data.tech && data.tech.length > 0 && <div class="ds"><h3>Tecnologías</h3><div>{data.tech.map((technology)=><span class="tc">{technology}</span>)}</div></div>}
    {['novabank','kinal-reports','scoph'].includes(project.slug) && data.architecture && <div class="ds"><h3>Arquitectura</h3><div><p>{data.architecture}</p></div></div>}
    {data.myRole && <div class="ds"><h3>Mi participación</h3><div><p>{data.myRole}</p>{data.learned && <p style="margin-top:1rem;color:#c3d0de">{data.learned}</p>}</div></div>}
    {gallery.length > 0 && <div class="ds"><h3>Galería</h3><div class="gal">{gallery.map((image,index)=><Image src={image} alt={`Captura ${index+1} de ${data.name}`} widths={[360,640,960]} sizes="(max-width:700px) 100vw, 33vw" loading="lazy" />)}</div></div>}
    {(data.links?.live || data.links?.repo) && <div class="ds"><h3>Enlaces</h3><div class="lk" style="margin:0">{data.links?.live && <a href={data.links.live} target="_blank" rel="noopener noreferrer">Ver proyecto</a>}{data.links?.repo && <a href={data.links.repo} target="_blank" rel="noopener noreferrer">Repositorio ↗</a>}</div></div>}
    <div class="pn" role="navigation" aria-label="Proyectos"><a href={`/projects/${previous.slug}`}><span class="mono">← Anterior</span><h4>{previous.data.name}</h4></a><a href={`/projects/${next.slug}`}><span class="mono">Siguiente →</span><h4>{next.data.name}</h4></a></div>
  </div></section>
</BaseLayout>
