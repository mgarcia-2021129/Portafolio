---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Reveal from '../../components/react/Reveal';
import ParallaxImage from '../../components/react/ParallaxImage';
import GlassButton from '../../components/ui/GlassButton.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

type Props = { project: CollectionEntry<'projects'> };
const { project } = Astro.props as Props;
const data = project.data;
const pending = 'Pendiente';
const categoryLabels = {
  academic: 'Académico',
  personal: 'Personal',
  professional: 'Profesional / colaborativo',
};
const category = data.category ? categoryLabels[data.category] : pending;
const gallery = data.gallery ?? [];
const features = data.features ?? [];
const technologies = data.tech ?? [];
---

<BaseLayout
  title={`${data.name} · ${site.shortName}`}
  description={data.shortDescription}
>
  <article class="section-shell pb-24 pt-28 sm:pb-32 sm:pt-36">
    <Reveal client:load variant="rise">
      <div class="mb-8">
        <a href="/projects" class="text-sm text-ink/55 transition-colors hover:text-accent">
          ← Volver a proyectos
        </a>
      </div>
    </Reveal>

    <Reveal client:load variant="zoom">
      <div class="glass-panel overflow-hidden">
        <ParallaxImage
          client:load
          src={data.cover}
          alt={`Portada de ${data.name}`}
          className="relative aspect-[16/9]"
        />
        <div class="relative z-10 space-y-5 p-6 sm:p-10">
          <h1 class="font-display text-3xl font-bold tracking-tight text-ink sm:text-5xl text-balance">
            {data.name}
          </h1>
          <p class="max-w-3xl text-base leading-relaxed text-ink/65 sm:text-lg">
            {data.description}
          </p>
          <dl class="grid gap-3 text-sm text-ink/65 sm:grid-cols-2 lg:grid-cols-4">
            <div><dt>Estado</dt><dd>{data.status ?? pending}</dd></div>
            <div><dt>Categoría</dt><dd>{category}</dd></div>
            <div><dt>Año</dt><dd>{data.year ?? pending}</dd></div>
            <div><dt>Equipo</dt><dd>{data.team ?? pending}</dd></div>
          </dl>
          <div class="pt-2">
            {data.links?.repo ? (
              <GlassButton href={data.links.repo} external>Ver repositorio</GlassButton>
            ) : (
              <p>Repositorio: {pending}</p>
            )}
          </div>
        </div>
      </div>
    </Reveal>

    <div class="mt-8 grid gap-5 lg:grid-cols-2">
      <Reveal client:load delay={0.1} variant="slide-left">
        <section class="glass-panel h-full p-6 sm:p-8">
          <div class="relative z-10">
            <h2 class="font-display text-xl font-semibold text-ink">Mi rol</h2>
            <p class="mt-4 text-sm leading-relaxed text-ink/65 sm:text-base">
              {data.myRole ?? pending}
            </p>
          </div>
        </section>
      </Reveal>
      <Reveal client:load delay={0.2} variant="slide-right">
        <section class="glass-panel h-full p-6 sm:p-8">
          <div class="relative z-10">
            <h2 class="font-display text-xl font-semibold text-ink">Aprendí</h2>
            <p class="mt-4 text-sm leading-relaxed text-ink/65 sm:text-base">
              {data.learned ?? pending}
            </p>
          </div>
        </section>
      </Reveal>
    </div>

    <div class="mt-5 grid gap-5 lg:grid-cols-3">
      <section class="glass-panel p-6 sm:p-8">
        <h2 class="font-display text-xl font-semibold text-ink">Objetivo</h2>
        <p class="mt-4 text-sm leading-relaxed text-ink/65 sm:text-base">{data.objective ?? pending}</p>
      </section>
      <section class="glass-panel p-6 sm:p-8">
        <h2 class="font-display text-xl font-semibold text-ink">Problema</h2>
        <p class="mt-4 text-sm leading-relaxed text-ink/65 sm:text-base">{data.problem ?? pending}</p>
      </section>
      <section class="glass-panel p-6 sm:p-8">
        <h2 class="font-display text-xl font-semibold text-ink">Solución</h2>
        <p class="mt-4 text-sm leading-relaxed text-ink/65 sm:text-base">{data.solution ?? pending}</p>
      </section>
    </div>

    <Reveal client:load delay={0.12} variant="rise">
      <section class="glass-panel mt-5 p-6 sm:p-8">
        <div class="relative z-10">
          <h2 class="font-display text-xl font-semibold text-ink">Tecnologías</h2>
          {technologies.length ? (
            <ul class="mt-5 flex flex-wrap gap-2">
              {technologies.map((tech) => (
                <li class="rounded-full border border-white/10 bg-white/[0.04] px-3 py-1.5 text-sm text-ink/80">
                  {tech}
                </li>
              ))}
            </ul>
          ) : <p class="mt-4">{pending}</p>}
        </div>
      </section>
    </Reveal>

    <Reveal client:load delay={0.16} variant="rise">
      <section class="glass-panel mt-5 p-6 sm:p-8">
        <div class="relative z-10">
          <h2 class="font-display text-xl font-semibold text-ink">Características principales</h2>
          {features.length ? (
            <ul class="mt-5 grid gap-3 sm:grid-cols-2">
              {features.map((feature) => (
                <li class="flex gap-3 text-sm leading-relaxed text-ink/70 sm:text-base">
                  <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent" />
                  <span>{feature}</span>
                </li>
              ))}
            </ul>
          ) : <p class="mt-4">{pending}</p>}
        </div>
      </section>
    </Reveal>

    {data.architecture && (
      <section class="glass-panel mt-5 p-6 sm:p-8">
        <h2 class="font-display text-xl font-semibold text-ink">Arquitectura</h2>
        <p class="mt-4 text-sm leading-relaxed text-ink/65 sm:text-base">{data.architecture}</p>
      </section>
    )}

    <section class="mt-10">
      <h2 class="mb-5 font-display text-xl font-semibold text-ink">Galería</h2>
      {gallery.length ? (
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {gallery.map((image, index) => (
            <div class="glass-panel overflow-hidden p-2">
              <ParallaxImage
                client:load
                src={image}
                alt={`${data.name} — imagen ${index + 1}`}
                className="aspect-[4/3] rounded-[1.05rem]"
              />
            </div>
          ))}
        </div>
      ) : <p>{pending}</p>}
    </section>

    <section class="mt-8">
      <h2 class="font-display text-xl font-semibold text-ink">Enlaces</h2>
      <div class="mt-3 flex flex-wrap gap-4 text-sm">
        {data.links?.live ? (
          <a href={data.links.live} target="_blank" rel="noopener noreferrer">Proyecto</a>
        ) : <span>Proyecto: {pending}</span>}
        {data.links?.repo ? (
          <a href={data.links.repo} target="_blank" rel="noopener noreferrer">Repositorio</a>
        ) : <span>Repositorio: {pending}</span>}
      </div>
    </section>
  </article>
</BaseLayout>
