---
interface Props {
  href: string;
  title: string;
  description?: string;
  image: string;
  compact?: boolean;
}

const { href, title, description, image, compact = false } = Astro.props;
---

<a
  href={href}
  class="glass-panel group relative block overflow-hidden transition-transform duration-700 hover:-translate-y-2 hover:shadow-glow"
>
  <div class={`relative overflow-hidden ${compact ? 'aspect-[4/3]' : 'aspect-[16/10]'}`}>
    <img
      src={image}
      alt={`Vista previa de ${title}`}
      class="h-full w-full object-cover transition-transform duration-[1.1s] ease-out group-hover:scale-110"
      loading="lazy"
      decoding="async"
    />
    <div
      class="pointer-events-none absolute inset-0 bg-gradient-to-t from-canvas via-canvas/25 to-transparent opacity-90"
    >
    </div>
  </div>
  <div class="relative z-10 space-y-2 p-5 sm:p-6">
    <h3 class="font-display text-xl font-semibold tracking-tight text-ink transition-colors group-hover:text-accent">
      {title}
    </h3>
    {
      description && (
        <p class="text-sm leading-relaxed text-ink/60 sm:text-base">{description}</p>
      )
    }
  </div>
</a>
