---
import { getCollection } from 'astro:content';
const entries = (await getCollection('experience')).sort((a, b) => a.data.order - b.data.order);
---
<section id="experience" data-n="03 - Experiencia" style="padding-top:0"><div class="wrap">
  <span class="sn mono"><b>03</b> / Experiencia profesional</span><h2>Camino <em>recorrido</em></h2>
  {entries.map(({ data }) => data.kind === 'internship' ? <article class="xp"><div class="mono" style="color:var(--cu)">Prácticas profesionales<br/><span style="color:var(--slate)">Práctica completada</span></div><div><h3>{data.org}</h3><dl>{data.role && <><dt>Rol</dt><dd>{data.role}</dd></>}{data.dates && <><dt>Fechas</dt><dd>{data.dates}</dd></>}{data.description && <><dt>Descripción</dt><dd>{data.description}</dd></>}{data.tech && data.tech.length > 0 && <><dt>Tecnologías</dt><dd>{data.tech.join(' · ')}</dd></>}</dl></div></article> : null)}
  <article class="xp"><div class="mono" style="color:var(--cu)">Formacion academica<br/><span style="color:var(--slate)">No es empleo formal</span></div><div><h3>Proyectos y trabajos de desarrollo</h3><dl><dt>Institucion</dt><dd>Centro Educativo Tecnico Laboral Kinal</dd><dt>Rol</dt><dd>Desarrollador (proyectos durante la formacion)</dd><dt>Fechas</dt><dd>2024-2026</dd><dt>Descripcion</dt><dd><a href="/projects" style="border-bottom:1px solid var(--cu)">Ver proyectos</a></dd><dt>Tecnologias</dt><dd><a href="/#technologies" style="border-bottom:1px solid var(--cu)">Ver tecnologias</a></dd></dl></div></article>
</div></section>
