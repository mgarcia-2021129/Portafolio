---
import Reveal from '../react/Reveal';
import SectionHeading from '../ui/SectionHeading.astro';
import { getCollection } from 'astro:content';

const experiences = (await getCollection('experience')).sort(
  (a, b) => a.data.order - b.data.order,
);
const pending = 'Pendiente';
---

<section class="section-shell py-20 sm:py-28" id="experiencia" aria-labelledby="exp-titulo">
  <Reveal client:load variant="mask">
    <SectionHeading id="exp-titulo" title="Experiencia" />
  </Reveal>

  <div class="grid gap-4 sm:grid-cols-2">
    {
      experiences.map(({ data }, index) => (
        <Reveal client:load delay={0.14 * index} variant="card">
          <article class="glass-panel h-full p-6">
            <div class="relative z-10">
              <p class="text-xs uppercase tracking-[0.16em] text-accent/80">
                {data.kind === 'internship' ? 'Prácticas profesionales' : data.kind}
              </p>
              <p class="mt-3 font-display text-lg font-semibold leading-snug text-ink">
                {data.org}
              </p>
              <dl class="mt-4 grid gap-2 text-sm text-ink/65">
                <div>
                  <dt class="inline">Cargo: </dt>
                  <dd class="inline">{data.role ?? pending}</dd>
                </div>
                <div>
                  <dt class="inline">Fechas: </dt>
                  <dd class="inline">{data.dates ?? pending}</dd>
                </div>
                <div>
                  <dt class="inline">Descripción: </dt>
                  <dd class="inline">{data.description ?? pending}</dd>
                </div>
                <div>
                  <dt class="inline">Responsabilidades: </dt>
                  <dd class="inline">
                    {data.responsibilities?.join(', ') ?? pending}
                  </dd>
                </div>
                <div>
                  <dt class="inline">Tecnologías: </dt>
                  <dd class="inline">{data.tech?.join(', ') ?? pending}</dd>
                </div>
              </dl>
            </div>
          </article>
        </Reveal>
      ))
    }
  </div>
</section>
