---
import { getCollection, getEntry } from 'astro:content';
const [about, profileEntry] = await Promise.all([getCollection('about'), getEntry('profile', 'site')]);
about.sort((a, b) => a.data.order - b.data.order);
const profile = profileEntry?.data;
---
<section class="about" id="about" data-n="02 · Sobre mí"><div class="wrap">
  <span class="sn mono"><b>02</b> / Sobre mí</span><h2>Desarrollador y <em>persona</em></h2>
  {profile?.tagline && <p class="pq">{profile.tagline}</p>}
  <div class="rows">{about.filter(({ data }) => data.body).map(({ data }) => <div class="rw"><h3>{data.title}</h3><p class="rv">{data.body}</p></div>)}</div>
  {(profile?.location || profile?.studying.program) && <div class="facts">{profile.location && <div class="mono">Ubicación<b>{profile.location}</b></div>}{profile.studying.program && <div class="mono">Título<b>{profile.studying.program}</b></div>}</div>}
</div></section>
