---
import Reveal from '../react/Reveal';
import SectionHeading from '../ui/SectionHeading.astro';
import { getCollection, getEntry } from 'astro:content';

const [profileEntry, aboutEntries] = await Promise.all([
  getEntry('profile', 'site'),
  getCollection('about'),
]);
if (!profileEntry) throw new Error('Falta la entrada de contenido profile/site.');
const cards = aboutEntries
  .sort((a, b) => a.data.order - b.data.order)
  .map(({ data }) => data);
---

<section class="section-shell py-20 sm:py-28" id="sobre-mi" aria-labelledby="sobre-titulo">
  <Reveal client:load variant="mask">
    <SectionHeading id="sobre-titulo" eyebrow="Sobre mí" title={profileEntry.data.role} />
  </Reveal>

  <div class="grid gap-5 lg:grid-cols-3">
    {
      cards.map((card, index) => (
        <Reveal
          client:load
          delay={0.15 * index}
          variant={index === 0 ? 'slide-left' : index === 2 ? 'slide-right' : 'card'}
        >
          <article class="glass-panel h-full p-6 sm:p-7">
            <div class="relative z-10">
              <div class="mb-5 h-px w-12 bg-gradient-to-r from-accent to-transparent" />
              <h3 class="font-display text-xl font-semibold text-ink">{card.title}</h3>
              <p class="mt-4 text-sm leading-relaxed text-ink/65 sm:text-base">
                {card.body ?? 'Pendiente'}
              </p>
            </div>
          </article>
        </Reveal>
      ))
    }
  </div>
</section>
