---
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import portrait from '../../assets/images/profile.jpeg';
const entry = await getEntry('profile', 'site');
if (!entry) throw new Error('Falta profile/site');
const profile = entry.data;
const nameParts = profile.fullName.split(' ');
const firstLine = nameParts.slice(0, 2).join(' ');
const secondLine = nameParts.slice(2).join(' ');
---
<header class="hero" data-n="01 · Presentación"><div class="wrap">
  <h1 class="name" id="nm"><span class="ln" data-split>{firstLine}</span><span class="ln" data-split>{secondLine}</span></h1>
  <div class="ph"><div class="dial" id="dial"></div><div class="dot" id="dot" aria-hidden="true"></div>
    <Image src={portrait} alt="Fotografía de Manuel Antonio Garcia Juárez" widths={[240,340,480]} sizes="(max-width:800px) 240px, 340px" loading="eager" fetchpriority="high" />
  </div>
  <div class="meta"><div class="cta"><span class="mono">{profile.role}</span><a class="p" href="/projects">Explorar proyectos <span aria-hidden="true">↓</span></a><a href="#contact">Contactar →</a></div><p>{profile.intro}</p></div>
  <div class="clock mono">Guatemala · <span id="ck">--:--</span> <span style="color:var(--cu)">●</span></div>
</div></header>
