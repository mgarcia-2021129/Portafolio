---
import { getEntry } from 'astro:content';
const entry = await getEntry('contact', 'contact');
const contact = entry?.data;
---
<section class="ct" id="contact" data-n="08 · Contacto"><div class="wrap">
  <span class="sn mono"><b>08</b> / Contacto</span><h2>Hablemos de <em>tu próximo proyecto</em></h2>
  {contact && <a class="mail" href={`mailto:${contact.email}`}>{contact.email}</a>}
  <div class="cl">{contact && <><a class="mono" href={contact.github.url} target="_blank" rel="noopener noreferrer">GitHub<b>{contact.github.label}</b></a><a class="mono" href={contact.linkedin.url} target="_blank" rel="noopener noreferrer">LinkedIn<b>{contact.linkedin.label}</b></a><a class="mono" href={contact.phone.href}>Teléfono<b>{contact.phone.label}</b></a></>}</div>
  <footer class="mono" style="margin-top:6rem"><span>© 2026 Manuel Antonio Garcia Juárez</span><span>Desarrollador Full Stack · Guatemala</span></footer>
</div></section>
