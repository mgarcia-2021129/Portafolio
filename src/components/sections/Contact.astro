---
import Reveal from '../react/Reveal';
import SectionHeading from '../ui/SectionHeading.astro';
import { getCollection } from 'astro:content';

const contactEntry = (await getCollection('contact'))[0];
if (!contactEntry) throw new Error('Falta la entrada de contenido contact/contact.');
const contact = contactEntry.data;

const channels = [
  {
    label: 'Correo',
    value: contact.email,
    href: `mailto:${contact.email}`,
    icon: 'mail',
  },
  {
    label: 'GitHub',
    value: contact.github.label,
    href: contact.github.url,
    icon: 'github',
  },
  {
    label: 'LinkedIn',
    value: contact.linkedin.label,
    href: contact.linkedin.url,
    icon: 'linkedin',
  },
  {
    label: 'Teléfono',
    value: contact.phone.label,
    href: contact.phone.href,
    icon: 'phone',
  },
];
---

<section class="section-shell py-20 pb-28 sm:py-28 sm:pb-36" id="contacto" aria-labelledby="contacto-titulo">
  <Reveal client:load variant="mask">
    <SectionHeading id="contacto-titulo" title="Contacto" />
  </Reveal>

  <div class="grid gap-4 sm:grid-cols-2">
    {
      channels.map((channel, index) => (
        <Reveal client:load delay={0.12 * index} variant="card">
          <a
            href={channel.href}
            class="glass-panel group block p-6 transition-transform duration-500 hover:-translate-y-1.5 hover:shadow-glow"
            target={channel.href.startsWith('http') ? '_blank' : undefined}
            rel={channel.href.startsWith('http') ? 'noopener noreferrer' : undefined}
          >
            <div class="relative z-10 flex items-start gap-4">
              <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl border border-white/10 bg-white/[0.04] text-accent transition-colors group-hover:border-accent/40 group-hover:bg-accent/10">
                {channel.icon === 'mail' && (
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M4 6.5h16v11H4v-11Z" stroke="currentColor" stroke-width="1.6" />
                    <path d="m5 7.5 7 5.5 7-5.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                )}
                {channel.icon === 'github' && (
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M12 2C6.48 2 2 6.58 2 12.26c0 4.52 2.87 8.35 6.84 9.7.5.1.68-.22.68-.48 0-.24-.01-.87-.01-1.7-2.78.62-3.37-1.37-3.37-1.37-.45-1.18-1.11-1.5-1.11-1.5-.91-.64.07-.63.07-.63 1 .07 1.53 1.06 1.53 1.06.89 1.57 2.34 1.12 2.91.86.09-.66.35-1.12.63-1.38-2.22-.26-4.56-1.14-4.56-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.31.1-2.73 0 0 .84-.27 2.75 1.05A9.2 9.2 0 0 1 12 7.5c.85 0 1.71.12 2.51.35 1.9-1.32 2.74-1.05 2.74-1.05.55 1.42.2 2.47.1 2.73.64.72 1.03 1.63 1.03 2.75 0 3.94-2.34 4.8-4.57 5.06.36.32.68.94.68 1.9 0 1.38-.01 2.49-.01 2.83 0 .26.18.59.69.48A10.27 10.27 0 0 0 22 12.26C22 6.58 17.52 2 12 2Z" />
                  </svg>
                )}
                {channel.icon === 'linkedin' && (
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M6.94 8.5H3.75V20h3.19V8.5ZM5.35 7.1a1.85 1.85 0 1 0 0-3.7 1.85 1.85 0 0 0 0 3.7ZM20.25 20h-3.18v-5.6c0-1.34-.02-3.05-1.86-3.05-1.86 0-2.15 1.45-2.15 2.95V20H9.88V8.5h3.05v1.57h.04c.43-.8 1.47-1.65 3.02-1.65 3.23 0 3.83 2.13 3.83 4.9V20Z" />
                  </svg>
                )}
                {channel.icon === 'phone' && (
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M8.2 4.8c.4-.4 1-.5 1.5-.3l2.1.9c.5.2.8.7.7 1.2l-.4 2.1a1.2 1.2 0 0 1-.7.9l-1.3.5a10.5 10.5 0 0 0 4.6 4.6l.5-1.3c.2-.4.5-.6.9-.7l2.1-.4c.5-.1 1 .2 1.2.7l.9 2.1c.2.5.1 1.1-.3 1.5l-1.2 1.2c-.4.4-1 .6-1.6.5C10.8 18.8 5.2 13.2 4.3 6.6c-.1-.6.1-1.2.5-1.6L8.2 4.8Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
                  </svg>
                )}
              </span>
              <div class="min-w-0">
                <p class="text-xs uppercase tracking-[0.16em] text-ink/45">{channel.label}</p>
                <p class="mt-2 truncate font-display text-lg font-semibold text-ink transition-colors group-hover:text-accent">
                  {channel.value}
                </p>
              </div>
            </div>
          </a>
        </Reveal>
      ))
    }
  </div>
</section>

<footer class="section-shell border-t border-white/5 py-10">
  <div class="flex flex-col gap-3 text-sm text-ink/45 sm:flex-row sm:items-center sm:justify-between">
    <p>© {new Date().getFullYear()} Manuel Antonio García Juárez</p>
    <p>Desarrollador Full Stack · Guatemala</p>
  </div>
</footer>
