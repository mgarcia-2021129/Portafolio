---
import { getCollection } from 'astro:content';
const entries = (await getCollection('education')).sort((a, b) => a.data.order - b.data.order);
---
<section id="education" data-n="07 - Educacion"><div class="wrap">
  <span class="sn mono"><b>07</b> / Educacion</span><h2>Como <em>aprendi</em></h2>
  <div class="tl">{entries.map(({ data }) => <article><h3>{data.stage}</h3><p class="mono" style="margin-bottom:.5rem">{data.program ? `${data.program} - ` : ''}{data.institution}{data.dates ? ` - ${data.dates}` : ''}</p>{data.description && <p>{data.description}</p>}</article>)}</div>
</div></section>
