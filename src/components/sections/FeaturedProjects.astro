---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
const projects = (await getCollection('projects', ({ data }) => data.featured)).sort((a, b) => a.data.order - b.data.order);
const images = import.meta.glob<{ default: import('astro').ImageMetadata }>('../../assets/images/projects/**/*.{webp,jpg,jpeg,png}', { eager: true });
const imageFor = (path: string) => Object.entries(images).find(([key]) => key.endsWith(`/${path.split('/').at(-1)}`))?.[1].default;
---
<section id="featured" data-n="04 · Proyectos" style="padding-top:0"><div class="wrap">
  <span class="sn mono"><b>04</b> / Proyectos destacados</span><h2>Trabajo <em>seleccionado</em></h2>
  <div class="pj">{projects.map((project, index) => { const image = imageFor(project.data.cover); return <a class="pr" href={`/projects/${project.slug}`} data-preview-row><span class="n mono">{String(index + 1).padStart(2, '0')}</span><div><h3>{project.data.name}</h3><small>{project.data.subtitle ?? project.data.shortDescription}</small></div><span class="go">Ver proyecto →</span>{image && <Image class="th" src={image} alt={`Captura de ${project.data.name}`} widths={[300]} sizes="300px" loading="lazy" />}</a>; })}</div>
  <p style="margin-top:2rem"><a class="mono" style="color:var(--cu);border-bottom:1px solid var(--cu)" href="/projects">Ver todos los proyectos →</a></p>
</div></section>
