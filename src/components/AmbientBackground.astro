---
---

<div aria-hidden="true" class="pointer-events-none fixed inset-0 z-0 overflow-hidden">
  <div class="absolute inset-0 bg-hero-glow"></div>
  <div class="ambient-orb ambient-orb-a absolute left-[8%] top-[18%] h-64 w-64 rounded-full bg-accent/20 blur-3xl"></div>
  <div class="ambient-orb ambient-orb-b absolute right-[6%] top-[35%] h-80 w-80 rounded-full bg-accent/10 blur-3xl"></div>
  <div class="ambient-orb ambient-orb-c absolute bottom-[10%] left-[35%] h-72 w-72 rounded-full bg-accent/10 blur-3xl"></div>
  <div
    class="absolute inset-0 opacity-[0.035]"
    style="background-image: radial-gradient(rgba(240,237,245,0.7) 0.6px, transparent 0.6px); background-size: 3px 3px;"
  >
  </div>
</div>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .ambient-orb {
      will-change: transform, opacity;
      animation: ambientFloat 16s ease-in-out infinite;
    }
    .ambient-orb-a {
      animation-duration: 14s;
    }
    .ambient-orb-b {
      animation-duration: 18s;
      animation-delay: 1.4s;
    }
    .ambient-orb-c {
      animation-duration: 16s;
      animation-delay: 2.8s;
    }
  }

  @keyframes ambientFloat {
    0%,
    100% {
      transform: translate3d(0, 0, 0) scale(1);
      opacity: 0.35;
    }
    35% {
      transform: translate3d(16px, -24px, 0) scale(1.08);
      opacity: 0.55;
    }
    70% {
      transform: translate3d(-10px, 10px, 0) scale(0.96);
      opacity: 0.4;
    }
  }
</style>
