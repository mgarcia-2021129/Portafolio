---
import '../styles/global.css';
import { site, cv } from '../data/site';
import manrope500 from '@fontsource/manrope/files/manrope-latin-500-normal.woff2?url';
import manrope700 from '@fontsource/manrope/files/manrope-latin-700-normal.woff2?url';
import manrope800 from '@fontsource/manrope/files/manrope-latin-800-normal.woff2?url';
import dmSans400 from '@fontsource/dm-sans/files/dm-sans-latin-400-normal.woff2?url';
interface Props { title?: string; description?: string; }
const { title = `${site.name} — ${site.title}`, description = site.description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0B1426" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="preload" href={manrope500} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={manrope700} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={manrope800} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={dmSans400} as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <nav aria-label="Principal">
      <a class="logo" href="/" aria-label="Inicio">MAG<span style="color:var(--cu)">.</span></a>
      <div class="nr">
        <ul class="hm">
          <li><a class="l" href="/#about">Sobre mí</a></li>
          <li><a class="l" href="/#experience">Experiencia</a></li>
          <li><a class="l" href="/projects">Proyectos</a></li>
        </ul>
        <details class="mm">
          <summary>Más</summary>
          <div>
            <a href="/#about">Sobre mí</a><a href="/#experience">Experiencia</a>
            <a href="/projects">Proyectos</a><a href="/#technologies">Tecnologías</a>
            <a href="/#activities">Actividades y reconocimientos</a>
            <a href="/#education">Educación</a><a href="/#contact">Contacto</a>
          </div>
        </details>
        {cv.available && <a class="cv" href={cv.href} download title="Descargar CV"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M8 2v8m0 0L5 7m3 3 3-3M3 13h10" /></svg>Descargar CV</a>}
      </div>
    </nav>
    <div class="rail" aria-hidden="true"><i></i><span class="mono" id="rl">01 · Presentación</span></div>
    <div class="toast" id="ts" role="status" aria-live="polite"></div>
    <main id="contenido"><slot /></main>
    <script is:inline>
      const rm = matchMedia('(prefers-reduced-motion:reduce)').matches;
      const fine = matchMedia('(hover:hover) and (pointer:fine)').matches;
      const $ = (selector) => document.querySelector(selector);
      const $$ = (selector) => [...document.querySelectorAll(selector)];

      $$('.mm a').forEach((link) => link.addEventListener('click', () => {
        link.closest('details').open = false;
      }));

      $$('[data-split]').forEach((element) => {
        const text = element.textContent;
        element.setAttribute('aria-label', text);
        element.innerHTML = [...text].map((character) => character === ' '
          ? ' '
          : `<span aria-hidden="true">${character}</span>`).join('');
      });

      const letters = $$('.name .ln span');
      let mouseX = -999;
      let mouseY = -999;
      let letterFrame = 0;
      function updateLetters() {
        letterFrame = 0;
        letters.forEach((letter) => {
          const rect = letter.getBoundingClientRect();
          const distance = Math.hypot(mouseX - (rect.left + rect.width / 2), mouseY - (rect.top + rect.height / 2));
          letter.style.setProperty('--p', Math.max(0, 1 - distance / 160).toFixed(2));
        });
      }
      if (fine && !rm) addEventListener('pointermove', (event) => {
        mouseX = event.clientX;
        mouseY = event.clientY;
        if (!letterFrame) letterFrame = requestAnimationFrame(updateLetters);
      });

      const clock = $('#ck');
      const dot = $('#dot');
      function updateClock() {
        const value = new Intl.DateTimeFormat('es-GT', {
          timeZone: 'America/Guatemala', hour: '2-digit', minute: '2-digit', hour12: false,
        }).format(new Date());
        if (clock) clock.textContent = value;
        if (dot) {
          const [hours, minutes] = value.split(':').map(Number);
          dot.style.setProperty('--ang', `${((hours * 60 + minutes) / 1440) * 360}deg`);
        }
      }
      updateClock();
      setInterval(updateClock, 30000);

      const revealWords = $$('.rv');
      revealWords.forEach((paragraph) => {
        paragraph.innerHTML = paragraph.textContent.trim().split(/\s+/)
          .map((word) => `<span class="w">${word}</span>`).join(' ');
        paragraph._words = [...paragraph.children];
      });

      const root = document.documentElement;
      const name = $('#nm');
      const dial = $('#dial');
      const railLabel = $('#rl');

      function avoidRailLabelCollision() {
        if (!railLabel || getComputedStyle(railLabel).display === 'none') return;
        const railRect = railLabel.getBoundingClientRect();
        const collides = $$('main h1, main h2, main h3, main p, main a, main button, main li, main dt, main dd').some((heading) => {
          const rect = heading.getBoundingClientRect();
          return rect.width > 0 && rect.height > 0
            && railRect.left < rect.right && railRect.right > rect.left
            && railRect.top < rect.bottom && railRect.bottom > rect.top;
        });
        railLabel.style.visibility = collides ? 'hidden' : '';
      }

      let scrollFrame = 0;
      function updateScrollEffects() {
        scrollFrame = 0;
        const y = scrollY;
        const viewportHeight = innerHeight;
        const maxScroll = Math.max(1, root.scrollHeight - viewportHeight);
        root.style.setProperty('--pr', (y / maxScroll).toFixed(4));
        if (!rm) {
          dial?.style.setProperty('--rot', (y * 0.12).toFixed(1));
          if (name && y < viewportHeight * 1.2) {
            name.style.transform = `translateY(${y * 0.18}px)`;
            name.style.opacity = String(Math.max(0, 1 - y / (viewportHeight * 0.9)));
          }
          revealWords.forEach((paragraph) => {
            const rect = paragraph.getBoundingClientRect();
            const progress = (viewportHeight * 0.9 - rect.top) / (viewportHeight * 0.55);
            const count = paragraph._words.length;
            paragraph._words.forEach((word, index) => {
              const opacity = Math.min(1, Math.max(0.18, progress * 1.3 - (index / count) * 0.9 + 0.1));
              word.style.setProperty('--o', opacity.toFixed(2));
            });
          });
        }
        avoidRailLabelCollision();
      }
      addEventListener('scroll', () => {
        if (!scrollFrame) scrollFrame = requestAnimationFrame(updateScrollEffects);
      }, { passive: true });
      addEventListener('resize', updateScrollEffects);
      updateScrollEffects();

      const sectionObserver = new IntersectionObserver((entries) => entries.forEach((entry) => {
        if (entry.isIntersecting && railLabel) {
          railLabel.textContent = entry.target.dataset.n;
          avoidRailLabelCollision();
        }
      }), { rootMargin: '-45% 0px -50% 0px' });
      $$('[data-n]').forEach((section) => sectionObserver.observe(section));

      if (fine && !rm) $$('.pr').forEach((row) => row.addEventListener('pointermove', (event) => {
        const bounds = row.getBoundingClientRect();
        const x = Math.min(bounds.width - 310, Math.max(bounds.width * 0.3, event.clientX - bounds.left + 30));
        row.style.setProperty('--x', `${x}px`);
      }));
    </script>
  </body>
</html>
